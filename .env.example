# =============================================================================
# .env.example — Environment variables for the Defang deployment
# =============================================================================
# Copy this file to `.env` and customize the values before running:
#   cp .env.example .env
#   # edit .env, then:
#   defang deploy
# =============================================================================

# ----- 3x-ui Admin Credentials ------------------------------------------------
# Username for the Farsi web panel login.
ADMIN_USERNAME=admin

# Password for the admin account.
# If left empty, a random 24-character password is generated on first boot
# and saved inside the container at /etc/x-ui/admin-credentials.txt
# (retrieve it with:  defang tail xray-panel  | grep "Password")
ADMIN_PASSWORD=ChangeMeStrongPassword123!

# ----- Internal Ports (do NOT change unless you also update nginx.conf) -----
# These are container-internal ports. Nginx listens on :80 (the only exposed
# port) and routes traffic to these internal services.
PANEL_PORT=2053
XRAY_VLESS_PORT=10001
XRAY_TROJAN_PORT=10002

# ----- WebSocket Paths (must match the paths in nginx.conf and config.json) --
XRAY_VLESS_PATH=/vless-ws/
XRAY_TROJAN_PATH=/trojan-ws/

# ----- Timezone ---------------------------------------------------------------
TZ=Asia/Tehran
